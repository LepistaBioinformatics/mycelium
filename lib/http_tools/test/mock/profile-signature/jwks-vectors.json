  "contract": {
    "audienceVariable": "MYC_PROFILE_SIGNATURE_AUDIENCE",
    "defaultMaxAgeSeconds": 43200,
    "emptyRetrySeconds": 5,
    "fetchTimeoutSeconds": 5,
    "insecureHttpVariable": "MYCELIUM_JWKS_ALLOW_INSECURE_HTTP",
    "maxBytes": 65536,
    "maxMaxAgeSeconds": 86400,
    "minMaxAgeSeconds": 60,
    "path": "/.well-known/mycelium-profile-jwks.json",
    "refetchCooldownSeconds": 30,
    "urlVariable": "MYCELIUM_JWKS_URL"
  },
  "description": "Profile JWKS contract vectors. Generated by the gateway (mycelium-http-tools tests/profile_jwks_contract.rs) from the real publisher. A document is accepted or refused as a whole. TEST ONLY keys (RFC 8032 section 7.1 vectors 1 and 2), the same keys as vectors.json. Do not edit by hand.",
  "published": "{\"keys\":[{\"alg\":\"EdDSA\",\"crv\":\"Ed25519\",\"kid\":\"1\",\"kty\":\"OKP\",\"use\":\"sig\",\"x\":\"11qYAYKxCrfVS_7TyWQHOg7hcvPapiMlrwIaaPcHURo\"},{\"alg\":\"EdDSA\",\"crv\":\"Ed25519\",\"kid\":\"2\",\"kty\":\"OKP\",\"use\":\"sig\",\"x\":\"PUAXw-hDiVqStwqnTRt-vJyYLM8uxJaMwM1V8Sr0Zgw\"}]}",
  "vectors": [
    {
      "description": "Exact document published by the gateway for keys 1 and 2",
      "document": "{\"keys\":[{\"alg\":\"EdDSA\",\"crv\":\"Ed25519\",\"kid\":\"1\",\"kty\":\"OKP\",\"use\":\"sig\",\"x\":\"11qYAYKxCrfVS_7TyWQHOg7hcvPapiMlrwIaaPcHURo\"},{\"alg\":\"EdDSA\",\"crv\":\"Ed25519\",\"kid\":\"2\",\"kty\":\"OKP\",\"use\":\"sig\",\"x\":\"PUAXw-hDiVqStwqnTRt-vJyYLM8uxJaMwM1V8Sr0Zgw\"}]}",
      "expected": "valid",
      "expectedKids": [
        "1",
        "2"
      ],
      "name": "valid_published"
    },
    {
      "description": "One key",
      "document": "{\"keys\":[{\"alg\":\"EdDSA\",\"crv\":\"Ed25519\",\"kid\":\"1\",\"kty\":\"OKP\",\"use\":\"sig\",\"x\":\"11qYAYKxCrfVS_7TyWQHOg7hcvPapiMlrwIaaPcHURo\"}]}",
      "expected": "valid",
      "expectedKids": [
        "1"
      ],
      "name": "valid_single_key"
    },
    {
      "description": "use and alg are optional",
      "document": "{\"keys\":[{\"crv\":\"Ed25519\",\"kid\":\"1\",\"kty\":\"OKP\",\"x\":\"11qYAYKxCrfVS_7TyWQHOg7hcvPapiMlrwIaaPcHURo\"}]}",
      "expected": "valid",
      "expectedKids": [
        "1"
      ],
      "name": "valid_without_optional_members"
    },
    {
      "description": "Unknown members are ignored (RFC 7517)",
      "document": "{\"keys\":[{\"alg\":\"EdDSA\",\"crv\":\"Ed25519\",\"extra\":\"ignored\",\"kid\":\"1\",\"kty\":\"OKP\",\"use\":\"sig\",\"x\":\"11qYAYKxCrfVS_7TyWQHOg7hcvPapiMlrwIaaPcHURo\"},{\"alg\":\"EdDSA\",\"crv\":\"Ed25519\",\"kid\":\"2\",\"kty\":\"OKP\",\"use\":\"sig\",\"x\":\"PUAXw-hDiVqStwqnTRt-vJyYLM8uxJaMwM1V8Sr0Zgw\"}]}",
      "expected": "valid",
      "expectedKids": [
        "1",
        "2"
      ],
      "name": "valid_unknown_members_ignored"
